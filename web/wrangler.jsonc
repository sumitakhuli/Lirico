{
  // Lirico website + download counter + anonymous stats.
  // Deploy:  cd web && npx wrangler deploy
  "name": "lirico",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/download", "/api/*", "/stats"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lirico", "database_id": "166fca07-20df-4828-8c7b-3f792f0b5868",
      "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
